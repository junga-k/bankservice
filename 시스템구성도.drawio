          <mxGeometry x="60" y="220" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="AI가 필요한 기능을 스스로 선택&#xa;(계좌조회 · 상품안내 · 고객지원 · 이체)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE4FB;strokeColor=#6D45B8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="필요한 데이터 조회 · 처리" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E4EEFF;strokeColor=#2F5FD6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="240" height="60" as="geometry" />

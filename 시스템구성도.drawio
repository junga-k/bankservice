        <!-- ── 1. 로그인 ── -->
        <mxCell id="S1" value="① 로그인" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ECECFF;strokeColor=#9370DB;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="180" height="60" as="geometry" />
